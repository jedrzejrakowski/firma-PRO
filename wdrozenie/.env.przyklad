# Ustawienia wdrożenia. Skopiuj ten plik pod nazwą .env i uzupełnij.
#
# Plik .env NIE trafia do repozytorium - są w nim hasła. Trzymaj go tylko
# na serwerze, z prawami dostępu wyłącznie dla właściciela:
#
#   cp .env.przyklad .env && chmod 600 .env

# Nazwa, pod którą program ma być dostępny. Dla prawdziwej domeny pośrednik
# sam pobierze certyfikat HTTPS; do sprawdzenia u siebie wpisz "localhost".
ADRES=faktury.mojafirma.pl

# Hasło do bazy danych. Wymyśl długie i losowe - nikt nie będzie go wpisywał
# ręcznie. Można je wygenerować poleceniem:
#   openssl rand -base64 32
HASLO_BAZY=

# Pierwsze konto właściciela. Zakładane jest przy pierwszym uruchomieniu,
# gdy w bazie nie ma jeszcze żadnego użytkownika. Później te ustawienia
# nie robią już nic - hasło zmienia się w programie, nie tutaj.
KONTO_EMAIL=
KONTO_HASLO=
FIRMA_NAZWA=
FIRMA_NIP=

# Czy obcy mogą zakładać u siebie konta przez stronę. Dla instalacji jednej
# firmy zostaw "false" - inaczej każdy, kto zna adres, założy sobie konto
# w Twoim programie. Ustaw "true", gdy program ma obsługiwać wiele firm.
REJESTRACJA_OTWARTA=false

# Kopie zapasowe: co ile godzin i ile pokoleń przechowywać.
# 24 godziny i 14 pokoleń to dwa tygodnie wstecz.
KOPIE_CO_ILE_GODZIN=24
KOPIE_ILE_POKOLEN=14
