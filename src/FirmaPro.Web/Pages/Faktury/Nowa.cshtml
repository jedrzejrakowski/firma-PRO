@page
@model FirmaPro.Web.Pages.Faktury.NowaModel
@{
    ViewData["Tytul"] = "Wystaw fakturę";
}

<h1>Wystaw fakturę</h1>
<p class="podtytul">Numer zostanie nadany automatycznie po zapisaniu.</p>

@if (Model.Bledy.Count > 0)
{
    <div class="powiadomienie niepowodzenie">
        <strong>Nie można wystawić faktury:</strong>
        <ul class="bledy">
            @foreach (string blad in Model.Bledy)
            {
                <li>@blad</li>
            }
        </ul>
    </div>
}

<form method="post">
    <div class="karta">
        <div class="siatka">
            <div class="pole">
                <label for="nabywca">Nabywca</label>
                <select id="nabywca" name="KontrahentId" required>
                    <option value="">— wybierz —</option>
                    @foreach (var kontrahent in Model.Kontrahenci)
                    {
                        <option value="@kontrahent.Id"
                                selected="@(kontrahent.Id == Model.KontrahentId)">
                            @kontrahent.Nazwa
                        </option>
                    }
                </select>
            </div>

            <div class="pole">
                <label for="dataWystawienia">Data wystawienia</label>
                <input type="date" id="dataWystawienia" name="DataWystawienia"
                       value="@Model.DataWystawienia.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="pole">
                <label for="dataSprzedazy">Data sprzedaży</label>
                <input type="date" id="dataSprzedazy" name="DataSprzedazy"
                       value="@Model.DataSprzedazy?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="pole">
                <label for="termin">Termin płatności</label>
                <input type="date" id="termin" name="TerminPlatnosci"
                       value="@Model.TerminPlatnosci?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="pole">
                <label for="waluta">Waluta</label>
                <select id="waluta" name="Waluta">
                    @foreach (string waluta in NowaModel.Waluty)
                    {
                        <option value="@waluta" selected="@(waluta == Model.Waluta)">@waluta</option>
                    }
                </select>
            </div>

            <div class="pole">
                <label for="forma">Forma płatności</label>
                <select id="forma" name="FormaPlatnosci">
                    @foreach (FormaPlatnosci forma in Enum.GetValues<FormaPlatnosci>())
                    {
                        <option value="@((int)forma)" selected="@(forma == Model.FormaPlatnosci)">
                            @NowaModel.OpisFormy(forma)
                        </option>
                    }
                </select>
            </div>
        </div>
    </div>

    @* Kurs pobierany jest dopiero przy zapisie, bo do jego ustalenia potrzeba
       daty wystawienia i sprzedaży - a te można jeszcze zmienić. *@
    <p class="wskazowka" id="wyjasnienieWaluty" style="display:none;margin:-8px 0 16px">
        Kwoty wpisujesz w wybranej walucie. Kurs średni NBP z dnia
        poprzedzającego program pobierze sam i wykaże podatek także w złotych —
        tego wymaga art. 106e ust. 11 ustawy o VAT.
    </p>

    <div class="karta">
        <h2 style="margin-top:0">Pozycje</h2>

        @* Podpowiedzi z cennika. Zwykły datalist, więc działa w każdej
           przeglądarce i nie przeszkadza, gdy ktoś woli wpisać nazwę ręcznie
           albo cennika w ogóle nie prowadzi. *@
        @if (Model.Cennik.Count > 0)
        {
            <datalist id="cennik">
                @foreach (PozycjaCennika pozycja in Model.Cennik)
                {
                    <option value="@pozycja.Nazwa">@Kwoty.NaTekst(pozycja.CenaNetto) zł / @pozycja.Jednostka</option>
                }
            </datalist>

            <script type="application/json" id="daneCennika">
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.Cennik.Select(p => new
                    {
                        nazwa = p.Nazwa,
                        jednostka = p.Jednostka,
                        cena = p.CenaNetto,
                        stawka = p.KodStawki,
                        gtu = p.Gtu ?? string.Empty
                    })))
            </script>
        }

        <table class="pozycje" id="tabelaPozycji">
            <thead>
                <tr>
                    <th style="width:36%">Nazwa towaru lub usługi</th>
                    <th style="width:10%">J.m.</th>
                    <th style="width:11%">Ilość</th>
                    <th style="width:14%">Cena netto</th>
                    <th style="width:14%">Stawka VAT</th>
                    <th style="width:11%">GTU</th>
                    <th style="width:4%"></th>
                </tr>
            </thead>
            <tbody id="cialoPozycji">
                @for (int i = 0; i < Model.Pozycje.Count; i++)
                {
                    <tr>
                        <td><input type="text" name="Pozycje[@i].Nazwa" value="@Model.Pozycje[i].Nazwa"
                                   maxlength="512" list="cennik" class="nazwa-pozycji" /></td>
                        <td><input type="text" name="Pozycje[@i].Jednostka" value="@Model.Pozycje[i].Jednostka" /></td>
                        <td><input type="number" step="0.000001" min="0" name="Pozycje[@i].Ilosc" value="@Model.Pozycje[i].Ilosc" /></td>
                        <td><input type="number" step="0.01" min="0" name="Pozycje[@i].CenaNetto" value="@Model.Pozycje[i].CenaNetto" /></td>
                        <td>
                            <select name="Pozycje[@i].KodStawki">
                                @foreach (StawkaVat stawka in StawkaVat.Wszystkie)
                                {
                                    <option value="@stawka.Kod" selected="@(stawka.Kod == Model.Pozycje[i].KodStawki)">
                                        @stawka.Opis
                                    </option>
                                }
                            </select>
                        </td>
                        <td>
                            <select name="Pozycje[@i].Gtu">
                                <option value="">—</option>
                                @foreach (string gtu in NowaModel.KodyGtu)
                                {
                                    <option value="@gtu" selected="@(gtu == Model.Pozycje[i].Gtu)">@gtu</option>
                                }
                            </select>
                        </td>
                        <td><button type="button" class="usun-wiersz" title="Usuń wiersz">×</button></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="paskiem">
            <button type="button" class="przycisk przycisk-drugi" id="dodajWiersz">
                Dodaj pozycję
            </button>
            <span class="drobne">
                @if (Model.Cennik.Count > 0)
                {
                    @:Zacznij pisać nazwę — podpowiedzą się pozycje z cennika.
                }
                else
                {
                    <a asp-page="/Cennik/Index">Załóż cennik</a>
                    @:, żeby nie wpisywać tych samych pozycji za każdym razem.
                }
            </span>
        </div>
    </div>

    @* Podmioty trzecie są rzadkie, więc sekcja jest zwinięta - zwykła faktura
       nie ma się przez nie wydłużać. Ale gdy są potrzebne, są potrzebne
       naprawdę: bez nich jednostka podrzędna samorządu nie zobaczy faktury
       w swoim KSeF, a odbiorca-oddział nie pojawi się na dokumencie. *@
    <details class="karta" id="kartaPodmiotow" open="@(Model.PodmiotyInne.Any(p => !p.CzyPusty))">
        <summary class="naglowek-zwijany">
            Podmioty inne — odbiorca, faktor, dodatkowy nabywca
        </summary>

        <p class="wskazowka" style="margin:10px 0 14px">
            Wypełnij tylko wtedy, gdy z fakturą związany jest ktoś poza
            sprzedawcą i nabywcą. Po numerze NIP podanym tutaj KSeF udostępni
            fakturę temu podmiotowi.
        </p>

        <div class="przewijak">
            <table class="pozycje" id="tabelaPodmiotow">
                <thead>
                    <tr>
                        <th style="width:22%">Rola</th>
                        <th>Nazwa</th>
                        <th style="width:14%">NIP</th>
                        <th style="width:20%">Adres</th>
                        <th style="width:9%">Udział %</th>
                        <th style="width:12%">Nr klienta</th>
                        <th style="width:4%"></th>
                    </tr>
                </thead>
                <tbody id="cialoPodmiotow">
                    @for (int i = 0; i < Model.PodmiotyInne.Count; i++)
                    {
                        <tr>
                            <td>
                                <select name="PodmiotyInne[@i].Rola">
                                    <option value="">— wybierz —</option>
                                    @foreach (RolaPodmiotu rola in NowaModel.Role)
                                    {
                                        <option value="@rola" selected="@(rola == Model.PodmiotyInne[i].Rola)">
                                            @NowaModel.NazwaRoli(rola)
                                        </option>
                                    }
                                </select>
                            </td>
                            <td><input type="text" name="PodmiotyInne[@i].Nazwa"
                                       value="@Model.PodmiotyInne[i].Nazwa" maxlength="512" /></td>
                            <td><input type="text" name="PodmiotyInne[@i].Nip"
                                       value="@Model.PodmiotyInne[i].Nip" maxlength="13" /></td>
                            <td><input type="text" name="PodmiotyInne[@i].AdresLinia1"
                                       value="@Model.PodmiotyInne[i].AdresLinia1" maxlength="512" /></td>
                            <td><input type="number" step="0.01" min="0" max="100"
                                       name="PodmiotyInne[@i].Udzial"
                                       value="@Model.PodmiotyInne[i].Udzial" /></td>
                            <td><input type="text" name="PodmiotyInne[@i].NrKlienta"
                                       value="@Model.PodmiotyInne[i].NrKlienta" maxlength="256" /></td>
                            <td class="usun">
                                <button type="button" class="usun-wiersz usunPodmiot"
                                        title="Usuń">&times;</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="paskiem">
            <button type="button" class="przycisk przycisk-drugi" id="dodajPodmiot">
                Dodaj podmiot
            </button>
            <span class="drobne">
                Udział wypełnia się tylko przy dodatkowym nabywcy — reszta
                przypada nabywcy z faktury.
            </span>
        </div>
    </details>

    <div class="karta" id="kartaZwolnienia" style="display:none">
        <div class="pole">
            <label for="zwolnienie">Podstawa zwolnienia z podatku</label>
            <input type="text" id="zwolnienie" name="PodstawaZwolnienia"
                   value="@Model.PodstawaZwolnienia" maxlength="256"
                   placeholder="np. art. 43 ust. 1 pkt 19 ustawy o VAT" />
            <p style="color:var(--tekst-szary);font-size:0.86rem;margin:6px 0 0">
                Wymagane, gdy na fakturze jest pozycja ze stawką „zwolniona”.
            </p>
        </div>
    </div>

    <div class="paskiem">
        <button type="submit">Wystaw fakturę</button>
        <a class="przycisk przycisk-drugi" asp-page="Index">Anuluj</a>
    </div>
</form>

@section Skrypty {
<script>
    // Dodawanie i usuwanie wierszy pozycji. Nazwy pól muszą zachować ciągłą
    // numerację, inaczej ASP.NET Core nie zwiąże ich z listą.
    (function () {
        const cialo = document.getElementById('cialoPozycji');
        const kartaZwolnienia = document.getElementById('kartaZwolnienia');

        function przenumeruj() {
            cialo.querySelectorAll('tr').forEach((wiersz, indeks) => {
                wiersz.querySelectorAll('[name]').forEach(pole => {
                    pole.name = pole.name.replace(/Pozycje\[\d+\]/, 'Pozycje[' + indeks + ']');
                });
            });
        }

        function pokazZwolnienieGdyTrzeba() {
            const jest = Array.from(cialo.querySelectorAll('select[name$=".KodStawki"]'))
                .some(pole => pole.value === 'zw');
            kartaZwolnienia.style.display = jest ? '' : 'none';
        }

        document.getElementById('dodajWiersz').addEventListener('click', () => {
            const wzor = cialo.querySelector('tr');
            const nowy = wzor.cloneNode(true);
            nowy.querySelectorAll('input').forEach(pole => {
                pole.value = pole.type === 'number' ? '' : '';
            });
            nowy.querySelector('input[name$=".Jednostka"]').value = 'szt.';
            cialo.appendChild(nowy);
            przenumeruj();
            pokazZwolnienieGdyTrzeba();
        });

        cialo.addEventListener('click', zdarzenie => {
            if (!zdarzenie.target.classList.contains('usun-wiersz')) return;
            if (cialo.querySelectorAll('tr').length === 1) return;
            zdarzenie.target.closest('tr').remove();
            przenumeruj();
            pokazZwolnienieGdyTrzeba();
        });

        cialo.addEventListener('change', pokazZwolnienieGdyTrzeba);
        pokazZwolnienieGdyTrzeba();

        // Podmioty trzecie - to samo dodawanie wierszy co przy pozycjach.
        // Osobna numeracja, bo to osobna lista po stronie serwera.
        const podmioty = document.getElementById('cialoPodmiotow');

        function przenumerujPodmioty() {
            podmioty.querySelectorAll('tr').forEach((wiersz, indeks) => {
                wiersz.querySelectorAll('[name]').forEach(pole => {
                    pole.name = pole.name.replace(
                        /PodmiotyInne\[\d+\]/, 'PodmiotyInne[' + indeks + ']');
                });
            });
        }

        document.getElementById('dodajPodmiot').addEventListener('click', () => {
            const nowy = podmioty.querySelector('tr').cloneNode(true);
            nowy.querySelectorAll('input').forEach(pole => { pole.value = ''; });
            nowy.querySelectorAll('select').forEach(pole => { pole.selectedIndex = 0; });
            podmioty.appendChild(nowy);
            przenumerujPodmioty();
        });

        podmioty.addEventListener('click', zdarzenie => {
            if (!zdarzenie.target.classList.contains('usunPodmiot')) return;

            // Ostatni wiersz zostaje pusty - inaczej nie byłoby czego klonować.
            if (podmioty.querySelectorAll('tr').length === 1) {
                zdarzenie.target.closest('tr')
                    .querySelectorAll('input').forEach(pole => { pole.value = ''; });
                return;
            }

            zdarzenie.target.closest('tr').remove();
            przenumerujPodmioty();
        });

        // Wyjaśnienie o kursie ma sens tylko przy walucie obcej.
        const waluta = document.getElementById('waluta');
        const wyjasnienie = document.getElementById('wyjasnienieWaluty');

        function pokazWyjasnienie() {
            wyjasnienie.style.display = waluta.value === 'PLN' ? 'none' : '';
        }

        waluta.addEventListener('change', pokazWyjasnienie);
        pokazWyjasnienie();

        // Wybór pozycji z cennika wypełnia resztę wiersza. Dopasowujemy po
        // pełnej nazwie, bo tylko taką wstawia lista podpowiedzi - wpisana
        // ręcznie nazwa własna niczego nie nadpisze.
        const dane = document.getElementById('daneCennika');

        if (dane) {
            const cennik = new Map(
                JSON.parse(dane.textContent).map(p => [p.nazwa, p]));

            cialo.addEventListener('input', zdarzenie => {
                const pole = zdarzenie.target;
                if (!pole.classList.contains('nazwa-pozycji')) return;

                const pozycja = cennik.get(pole.value);
                if (!pozycja) return;

                const wiersz = pole.closest('tr');
                const ustaw = (koncowka, wartosc) => {
                    const cel = wiersz.querySelector('[name$="' + koncowka + '"]');
                    if (cel) cel.value = wartosc;
                };

                ustaw('.Jednostka', pozycja.jednostka);
                ustaw('.CenaNetto', pozycja.cena);
                ustaw('.KodStawki', pozycja.stawka);
                ustaw('.Gtu', pozycja.gtu);

                pokazZwolnienieGdyTrzeba();
            });
        }
    })();
</script>
}
