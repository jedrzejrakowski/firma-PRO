@page
@model FirmaPro.Web.Pages.Faktury.ZaliczkowaModel
@{
    ViewData["Tytul"] = "Faktura zaliczkowa";
}

<h1>Faktura zaliczkowa</h1>
<p class="podtytul">
    Dokumentuje otrzymaną wpłatę, a nie dostawę — dlatego pozycje opisują tu
    <strong>zamówienie</strong>, a kwota to pieniądze, które wpłynęły.
</p>

@if (Model.Bledy.Count > 0)
{
    <div class="powiadomienie niepowodzenie">
        <strong>Nie można wystawić faktury:</strong>
        <ul class="bledy">
            @foreach (string blad in Model.Bledy)
            {
                <li>@blad</li>
            }
        </ul>
    </div>
}

<form method="post">
    <div class="karta">
        <div class="siatka">
            <div class="pole">
                <label for="nabywca">Nabywca</label>
                <select id="nabywca" name="KontrahentId" required>
                    <option value="">— wybierz —</option>
                    @foreach (Kontrahent kontrahent in Model.Kontrahenci)
                    {
                        <option value="@kontrahent.Id"
                                selected="@(kontrahent.Id == Model.KontrahentId)">
                            @kontrahent.Nazwa
                        </option>
                    }
                </select>
            </div>

            <div class="pole">
                <label for="dataWystawienia">Data otrzymania zaliczki</label>
                <input type="date" id="dataWystawienia" name="DataWystawienia"
                       value="@Model.DataWystawienia.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="pole">
                <label for="kwota">Kwota zaliczki (brutto)</label>
                <input type="number" id="kwota" name="KwotaZaliczki" step="0.01" min="0.01"
                       value="@(Model.KwotaZaliczki > 0 ? Model.KwotaZaliczki.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")"
                       required />
            </div>

            <div class="pole">
                <label for="forma">Forma płatności</label>
                <select id="forma" name="FormaPlatnosci">
                    @foreach (FormaPlatnosci forma in Enum.GetValues<FormaPlatnosci>())
                    {
                        <option value="@((int)forma)" selected="@(forma == Model.FormaPlatnosci)">
                            @NowaModel.OpisFormy(forma)
                        </option>
                    }
                </select>
            </div>
        </div>

        <p class="wskazowka">
            Zaliczka jest kwotą brutto — podatek liczy się od niej „w stu”
            i dzieli między stawki proporcjonalnie do wartości zamówienia.
        </p>
    </div>

    <div class="karta">
        <h2 style="margin-top:0">Zamówienie</h2>

        <table class="pozycje" id="tabelaPozycji">
            <thead>
                <tr>
                    <th style="width:36%">Nazwa towaru lub usługi</th>
                    <th style="width:10%">J.m.</th>
                    <th style="width:11%">Ilość</th>
                    <th style="width:14%">Cena netto</th>
                    <th style="width:14%">Stawka VAT</th>
                    <th style="width:11%">GTU</th>
                    <th style="width:4%"></th>
                </tr>
            </thead>
            <tbody id="cialoPozycji">
                @for (int i = 0; i < Model.Zamowienie.Count; i++)
                {
                    <tr>
                        <td><input type="text" name="Zamowienie[@i].Nazwa" value="@Model.Zamowienie[i].Nazwa" maxlength="512" /></td>
                        <td><input type="text" name="Zamowienie[@i].Jednostka" value="@Model.Zamowienie[i].Jednostka" /></td>
                        <td><input type="number" step="0.000001" min="0" name="Zamowienie[@i].Ilosc" value="@Model.Zamowienie[i].Ilosc" /></td>
                        <td><input type="number" step="0.01" min="0" name="Zamowienie[@i].CenaNetto" value="@Model.Zamowienie[i].CenaNetto" /></td>
                        <td>
                            <select name="Zamowienie[@i].KodStawki">
                                @foreach (StawkaVat stawka in StawkaVat.Wszystkie)
                                {
                                    <option value="@stawka.Kod" selected="@(stawka.Kod == Model.Zamowienie[i].KodStawki)">
                                        @stawka.Opis
                                    </option>
                                }
                            </select>
                        </td>
                        <td>
                            <select name="Zamowienie[@i].Gtu">
                                <option value="">—</option>
                                @foreach (string gtu in NowaModel.KodyGtu)
                                {
                                    <option value="@gtu" selected="@(gtu == Model.Zamowienie[i].Gtu)">@gtu</option>
                                }
                            </select>
                        </td>
                        <td><button type="button" class="usun-wiersz" title="Usuń wiersz">×</button></td>
                    </tr>
                }
            </tbody>
        </table>

        <p style="margin-top:12px">
            <button type="button" class="przycisk przycisk-drugi" id="dodajWiersz">
                Dodaj pozycję
            </button>
        </p>
    </div>

    <div class="paskiem">
        <button type="submit">Wystaw fakturę zaliczkową</button>
        <a class="przycisk przycisk-drugi" asp-page="Index">Anuluj</a>
    </div>
</form>

@section Skrypty {
<script>
    // Ten sam mechanizm co przy zwykłej fakturze: nazwy pól muszą zachować
    // ciągłą numerację, inaczej ASP.NET Core nie zwiąże ich z listą.
    (function () {
        const cialo = document.getElementById('cialoPozycji');

        function przenumeruj() {
            cialo.querySelectorAll('tr').forEach((wiersz, indeks) => {
                wiersz.querySelectorAll('[name]').forEach(pole => {
                    pole.name = pole.name.replace(/Zamowienie\[\d+\]/, 'Zamowienie[' + indeks + ']');
                });
            });
        }

        document.getElementById('dodajWiersz').addEventListener('click', () => {
            const nowy = cialo.querySelector('tr').cloneNode(true);
            nowy.querySelectorAll('input').forEach(pole => { pole.value = ''; });
            nowy.querySelector('input[name$=".Jednostka"]').value = 'szt.';
            cialo.appendChild(nowy);
            przenumeruj();
        });

        cialo.addEventListener('click', zdarzenie => {
            if (!zdarzenie.target.classList.contains('usun-wiersz')) return;
            if (cialo.querySelectorAll('tr').length === 1) return;
            zdarzenie.target.closest('tr').remove();
            przenumeruj();
        });
    })();
</script>
}
