@page
@model FirmaPro.Web.Pages.Faktury.IndexModel
@{
    ViewData["Tytul"] = "Faktury";
    bool koszty = Model.KosztyNaWierzchu;
}

<div class="naglowek-ekranu">
    <div>
        <h1>Faktury</h1>
        <p class="podtytul">Sprzedaż i koszty firmy w jednym miejscu.</p>
    </div>
</div>

<div class="zakladki" role="tablist">
    <button type="button" role="tab" data-zakladka="przychody" aria-controls="panel-przychody"
            aria-selected="@((!koszty).ToString().ToLowerInvariant())">
        Przychody
        <span class="ile">@Model.Faktury.Count</span>
    </button>
    <button type="button" role="tab" data-zakladka="koszty" aria-controls="panel-koszty"
            aria-selected="@koszty.ToString().ToLowerInvariant()">
        Koszty
        <span class="ile">@Model.Zakupy.Count</span>
    </button>
</div>

<section id="panel-przychody" role="tabpanel" hidden="@koszty">
    @if (Model.Faktury.Count == 0)
    {
        <div class="pusto">
            Nie wystawiono jeszcze żadnej faktury.<br />
            Zacznij od przycisku „Wystaw fakturę” na górze ekranu.
        </div>
    }
    else
    {
        <div class="przewijak">
            <table>
                <thead>
                    <tr>
                        <th>Numer</th>
                        <th>Data</th>
                        <th>Nabywca</th>
                        <th class="liczba">Netto</th>
                        <th class="liczba">VAT</th>
                        <th class="liczba">Brutto</th>
                        <th>Status</th>
                        <th>Numer KSeF</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (FakturaSprzedazy faktura in Model.Faktury)
                    {
                        <tr>
                            <td class="nowrap"><strong>@faktura.Numer</strong></td>
                            <td class="nowrap">@faktura.DataWystawienia.ToString("yyyy-MM-dd")</td>
                            <td>@faktura.NabywcaNazwa</td>
                            <td class="liczba">@Kwoty.NaTekst(faktura.RazemNetto)</td>
                            <td class="liczba">@Kwoty.NaTekst(faktura.RazemVat)</td>
                            <td class="liczba"><strong>@Kwoty.NaTekst(faktura.RazemBrutto)</strong></td>
                            <td>
                                <span class="znacznik znacznik-@faktura.Status.ToString().ToLowerInvariant()">
                                    @IndexModel.OpisStatusu(faktura.Status)
                                </span>
                            </td>
                            <td class="numer-ksef">@faktura.NumerKsef</td>
                            <td class="nowrap">
                                <a asp-page="Szczegoly" asp-route-id="@faktura.Id">Szczegóły</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section id="panel-koszty" role="tabpanel" hidden="@(!koszty)">
    <div class="pasek-narzedzi">
        <a class="przycisk przycisk-drugi przycisk-maly" asp-page="/Zakupy/Nowa">Wprowadź fakturę kosztową</a>
        <a class="przycisk przycisk-drugi przycisk-maly" asp-page="/Zakupy/Import">Pobierz z KSeF</a>
        <a class="przycisk przycisk-drugi przycisk-maly" asp-page="/Rejestry/Vat">Rejestr VAT</a>
    </div>

    @if (Model.Zakupy.Count == 0)
    {
        <div class="pusto">
            Nie wprowadzono jeszcze żadnej faktury kosztowej.<br />
            Możesz je pobrać z KSeF jednym kliknięciem.
        </div>
    }
    else
    {
        <div class="przewijak">
            <table>
                <thead>
                    <tr>
                        <th>Okres odliczenia</th>
                        <th>Numer</th>
                        <th>Sprzedawca</th>
                        <th>Wystawiono</th>
                        <th>Wpłynęła</th>
                        <th class="liczba">Netto</th>
                        <th class="liczba">VAT</th>
                        <th class="liczba">Brutto</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (FakturaZakupu faktura in Model.Zakupy)
                    {
                        <tr>
                            <td class="nowrap">@Model.OpisOkresu(faktura.DataUjecia)</td>
                            <td class="nowrap"><strong>@faktura.Numer</strong></td>
                            <td>
                                @faktura.SprzedawcaNazwa
                                @if (!faktura.Odliczany)
                                {
                                    <span class="znacznik znacznik-robocza">bez odliczenia</span>
                                }
                                @if (faktura.Rodzaj == RodzajZakupu.SrodkiTrwale)
                                {
                                    <span class="znacznik znacznik-robocza">środek trwały</span>
                                }
                            </td>
                            <td class="nowrap">@faktura.DataWystawienia.ToString("yyyy-MM-dd")</td>
                            <td class="nowrap">@faktura.DataWplywu.ToString("yyyy-MM-dd")</td>
                            <td class="liczba">@Kwoty.NaTekst(faktura.RazemNetto)</td>
                            <td class="liczba">@Kwoty.NaTekst(faktura.RazemVat)</td>
                            <td class="liczba"><strong>@Kwoty.NaTekst(faktura.RazemBrutto)</strong></td>
                            <td class="dzialania-wiersza">
                                @* Faktura zakupu nie ma u nas własnego ekranu -
                                   jej treść jest w pliku od dostawcy, więc jedyne,
                                   co da się z niej zrobić, to wizualizacja. *@
                                @if (faktura.MaXmlKsef)
                                {
                                    <a class="przycisk przycisk-drugi przycisk-maly"
                                       asp-page-handler="WizualizacjaZakupu"
                                       asp-route-id="@faktura.Id">Wizualizacja</a>
                                }
                                <form method="post" asp-page-handler="UsunZakup" asp-route-id="@faktura.Id"
                                      onsubmit="return confirm('Usunąć fakturę @faktura.Numer z rejestru?')">
                                    <button type="submit" class="usun-wiersz" title="Usuń">&times;</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
