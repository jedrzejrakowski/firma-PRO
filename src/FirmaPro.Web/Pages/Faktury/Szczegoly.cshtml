@page "{id:guid}"
@model FirmaPro.Web.Pages.Faktury.SzczegolyModel
@{
    ViewData["Tytul"] = "Faktura " + Model.Faktura.Numer;
}

<h1>Faktura @Model.Faktura.Numer</h1>
<p class="podtytul">
    Wystawiona @Model.Faktura.DataWystawienia.ToString("yyyy-MM-dd")
    dla @Model.Faktura.NabywcaNazwa
</p>

<div class="karta">
    <div class="siatka">
        <div>
            <div class="etykieta" style="color:var(--tekst-szary);font-size:0.82rem">Status</div>
            <p>
                <span class="znacznik znacznik-@Model.Faktura.Status.ToString().ToLowerInvariant()">
                    @IndexModel.OpisStatusu(Model.Faktura.Status)
                </span>
            </p>
        </div>
        <div>
            <div class="etykieta" style="color:var(--tekst-szary);font-size:0.82rem">Numer KSeF</div>
            <p class="numer-ksef">
                @(string.IsNullOrWhiteSpace(Model.Faktura.NumerKsef) ? "—" : Model.Faktura.NumerKsef)
            </p>
        </div>
        <div>
            <div class="etykieta" style="color:var(--tekst-szary);font-size:0.82rem">Termin płatności</div>
            <p>@(Model.Faktura.TerminPlatnosci?.ToString("yyyy-MM-dd") ?? "—")</p>
        </div>
    </div>

    @if (!Model.SwiezyKomunikat && !string.IsNullOrWhiteSpace(Model.Faktura.UwagiKsef))
    {
        <div class="powiadomienie @(Model.Faktura.Status == StatusKsef.Przyjeta ? "powodzenie" : "niepowodzenie")">
            @Model.Faktura.UwagiKsef
        </div>
    }
</div>

<div class="karta">
    <h2 style="margin-top:0">Pozycje</h2>
    <table>
        <thead>
            <tr>
                <th>Lp.</th>
                <th>Nazwa</th>
                <th>J.m.</th>
                <th class="liczba">Ilość</th>
                <th class="liczba">Cena netto</th>
                <th>Stawka</th>
                <th class="liczba">Wartość netto</th>
                <th class="liczba">VAT</th>
            </tr>
        </thead>
        <tbody>
            @foreach (PozycjaFakturySprzedazy pozycja in Model.Faktura.Pozycje.OrderBy(p => p.NrWiersza))
            {
                <tr>
                    <td>@pozycja.NrWiersza</td>
                    <td>
                        @pozycja.Nazwa
                        @if (!string.IsNullOrWhiteSpace(pozycja.Gtu))
                        {
                            <span style="color:var(--tekst-szary)"> (@pozycja.Gtu)</span>
                        }
                    </td>
                    <td>@pozycja.Jednostka</td>
                    <td class="liczba">@pozycja.Ilosc.ToString("0.######")</td>
                    <td class="liczba">@pozycja.CenaNetto.ToString("N2")</td>
                    <td>@SzczegolyModel.OpisStawki(pozycja.KodStawki)</td>
                    <td class="liczba">@pozycja.WartoscNetto.ToString("N2")</td>
                    <td class="liczba">@pozycja.KwotaVat.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="podsumowanie-kwot">
        <div>
            <div class="etykieta">Netto</div>
            <div class="kwota">@Model.Faktura.RazemNetto.ToString("N2")</div>
        </div>
        <div>
            <div class="etykieta">VAT</div>
            <div class="kwota">@Model.Faktura.RazemVat.ToString("N2")</div>
        </div>
        <div class="razem">
            <div class="etykieta">Do zapłaty</div>
            <div class="kwota">@Model.Faktura.RazemBrutto.ToString("N2") @Model.Faktura.Waluta</div>
        </div>
    </div>
</div>

<div class="paskiem">
    @if (Model.Faktura.Status != StatusKsef.Przyjeta)
    {
        <form method="post" asp-page-handler="Wyslij">
            <button type="submit">Wyślij do KSeF</button>
        </form>
    }

    @if (!Model.Faktura.CzyKorekta)
    {
        <a class="przycisk przycisk-drugi" asp-page="Korekta"
           asp-route-id="@Model.Faktura.Id">Wystaw korektę</a>
    }

    <a class="przycisk" asp-page-handler="Pdf"
       asp-route-id="@Model.Faktura.Id">Pobierz PDF</a>
    <a class="przycisk przycisk-drugi" asp-page-handler="Xml"
       asp-route-id="@Model.Faktura.Id">Pobierz XML</a>
    <a class="przycisk przycisk-drugi" asp-page="Index">Wróć do listy</a>
</div>


<h2>Wyślij kontrahentowi</h2>

@if (Model.WalidacjaWysylki.SaBledy)
{
    <div class="powiadomienie niepowodzenie">
        <ul class="bledy">
            @foreach (Problem problem in Model.WalidacjaWysylki.Problemy
                          .Where(p => p.Poziom == PoziomProblemu.Blad))
            {
                <li>@problem.Komunikat</li>
            }
        </ul>
    </div>
}

<div class="karta">
    @if (!Model.PocztaDziala)
    {
        <p class="wskazowka" style="margin:0">
            Poczta nie jest skonfigurowana w tej instalacji, więc program nie wyśle
            wiadomości. Pobierz PDF powyżej i wyślij go swoją pocztą — albo poproś
            o ustawienie serwera poczty we wdrożeniu.
        </p>
    }
    else
    {
        <form method="post" asp-page-handler="Poczta" asp-route-id="@Model.Faktura.Id">
            <div class="pole">
                <label for="adres">Adres odbiorcy</label>
                <input type="email" id="adres" name="Adres" value="@Model.Adres"
                       required maxlength="256" />
            </div>

            <div class="pole">
                <label for="wiadomosc">Wiadomość (opcjonalnie)</label>
                <input type="text" id="wiadomosc" name="Wiadomosc" value="@Model.Wiadomosc"
                       maxlength="500"
                       placeholder="W załączeniu przesyłamy fakturę." />
            </div>

            <div class="pole-wyboru">
                @* Odznaczone pole wyboru nie wysyła nic, więc pod spodem stoi
                   ukryte pole z wartością przeciwną. *@
                <input type="checkbox" id="xml" name="DolaczXml" value="true" />
                <input type="hidden" name="DolaczXml" value="false" />
                <label for="xml">Dołącz także plik XML</label>
            </div>

            <p class="wskazowka">
                W załączeniu idzie ta sama wizualizacja PDF, którą można pobrać
                powyżej — z kodem QR, jeśli faktura jest już w KSeF.
            </p>

            <div class="paskiem">
                <button type="submit">Wyślij e-mailem</button>
            </div>
        </form>
    }
</div>

@if (Model.Wysylki.Count > 0)
{
    <table>
        <thead>
            <tr>
                <th>Wysłano</th>
                <th>Adres</th>
                <th>Załączniki</th>
            </tr>
        </thead>
        <tbody>
            @foreach (WyslanieFaktury wyslanie in Model.Wysylki)
            {
                <tr>
                    <td class="nowrap">@wyslanie.WyslanoUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@wyslanie.Adres</td>
                    <td>@(wyslanie.ZXmlem ? "PDF i XML" : "PDF")</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.Faktura.Status != StatusKsef.Przyjeta)
{
    <p style="color:var(--tekst-szary);font-size:0.88rem;margin-top:14px">
        Wysłanej faktury nie można usunąć ani poprawić — błędy koryguje się
        fakturą korygującą.
    </p>
}
