@page "{id:guid}"
@using System.Globalization
@model FirmaPro.Web.Pages.Faktury.SzczegolyModel
@{
    ViewData["Tytul"] = "Faktura " + Model.Faktura.Numer;
}

<h1>Faktura @Model.Faktura.Numer</h1>
<p class="podtytul">
    Wystawiona @Model.Faktura.DataWystawienia.ToString("yyyy-MM-dd")
    dla @Model.Faktura.NabywcaNazwa
</p>

<div class="karta">
    <div class="siatka">
        <div>
            <div class="etykieta" style="color:var(--tekst-szary);font-size:0.82rem">Status</div>
            <p>
                <span class="znacznik znacznik-@Model.Faktura.Status.ToString().ToLowerInvariant()">
                    @IndexModel.OpisStatusu(Model.Faktura.Status)
                </span>
            </p>
        </div>
        <div>
            <div class="etykieta" style="color:var(--tekst-szary);font-size:0.82rem">Numer KSeF</div>
            <p class="numer-ksef">
                @(string.IsNullOrWhiteSpace(Model.Faktura.NumerKsef) ? "—" : Model.Faktura.NumerKsef)
            </p>
        </div>
        <div>
            <div class="etykieta" style="color:var(--tekst-szary);font-size:0.82rem">Termin płatności</div>
            <p>@(Model.Faktura.TerminPlatnosci?.ToString("yyyy-MM-dd") ?? "—")</p>
        </div>
        @* Urzędowe poświadczenie odbioru pokazujemy tylko dla faktur, które
           w ogóle mogą je mieć - przy roboczej byłaby to pusta obietnica. *@
        @if (Model.Faktura.Status == StatusKsef.Przyjeta)
        {
            <div>
                <div class="etykieta" style="color:var(--tekst-szary);font-size:0.82rem">
                    Poświadczenie odbioru
                </div>
                <p>
                    @if (Model.Faktura.MaUpo)
                    {
                        <a asp-page-handler="Upo" asp-route-id="@Model.Faktura.Id">
                            Pobierz UPO
                        </a>
                        <span class="drobne">
                            pobrane @Model.Faktura.DataUpoUtc?.ToString("yyyy-MM-dd HH:mm")
                        </span>
                    }
                    else
                    {
                        <span class="znacznik znacznik-wyslana">jeszcze nie pobrane</span>
                    }
                </p>
            </div>
        }
    </div>

    @if (!Model.SwiezyKomunikat && !string.IsNullOrWhiteSpace(Model.Faktura.UwagiKsef))
    {
        <div class="powiadomienie @(Model.Faktura.Status == StatusKsef.Przyjeta ? "powodzenie" : "niepowodzenie")">
            @Model.Faktura.UwagiKsef
        </div>
    }
</div>

<div class="karta">
    <h2 style="margin-top:0">Pozycje</h2>
    <table>
        <thead>
            <tr>
                <th>Lp.</th>
                <th>Nazwa</th>
                <th>J.m.</th>
                <th class="liczba">Ilość</th>
                <th class="liczba">Cena netto</th>
                <th>Stawka</th>
                <th class="liczba">Wartość netto</th>
                <th class="liczba">VAT</th>
            </tr>
        </thead>
        <tbody>
            @foreach (PozycjaFakturySprzedazy pozycja in Model.Faktura.Pozycje.OrderBy(p => p.NrWiersza))
            {
                <tr>
                    <td>@pozycja.NrWiersza</td>
                    <td>
                        @pozycja.Nazwa
                        @if (!string.IsNullOrWhiteSpace(pozycja.Gtu))
                        {
                            <span style="color:var(--tekst-szary)"> (@pozycja.Gtu)</span>
                        }
                    </td>
                    <td>@pozycja.Jednostka</td>
                    <td class="liczba">@pozycja.Ilosc.ToString("0.######")</td>
                    <td class="liczba">@Kwoty.NaTekst(pozycja.CenaNetto)</td>
                    <td>@SzczegolyModel.OpisStawki(pozycja.KodStawki)</td>
                    <td class="liczba">@Kwoty.NaTekst(pozycja.WartoscNetto)</td>
                    <td class="liczba">@Kwoty.NaTekst(pozycja.KwotaVat)</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="podsumowanie-kwot">
        <div>
            <div class="etykieta">Netto</div>
            <div class="kwota">@Kwoty.NaTekst(Model.Faktura.RazemNetto)</div>
        </div>
        <div>
            <div class="etykieta">VAT</div>
            <div class="kwota">@Kwoty.NaTekst(Model.Faktura.RazemVat)</div>
        </div>
        <div class="razem">
            <div class="etykieta">@(Model.Faktura.RozliczoneZaliczki.Count > 0 ? "Wartość dostawy" : "Do zapłaty")</div>
            <div class="kwota">@Kwoty.NaTekst(Model.Faktura.RazemBrutto) @Model.Faktura.Waluta</div>
        </div>
    </div>

    @* Faktura w obcej walucie musi wykazywać podatek także w złotych
       (art. 106e ust. 11 ustawy) - i to ta kwota trafia do rejestru VAT
       oraz do deklaracji. Numer tabeli jest dowodem, skąd wziął się kurs. *@
    @if (Model.Faktura.Walutowa && Model.Faktura.KursWaluty is decimal kurs)
    {
        <p class="uwaga-kursu">
            Kurs: 1 @Model.Faktura.Waluta = @Kwoty.KursNaTekst(kurs) PLN
            @if (Model.Faktura.KursZDnia is DateOnly zDnia)
            {
                <text>(tabela NBP @(Model.Faktura.KursTabela is { Length: > 0 } tabela
                    ? tabela + " z " : string.Empty)@zDnia.ToString("yyyy-MM-dd"))</text>
            }
            &middot;
            <strong>VAT w złotych:
                @Kwoty.NaTekst(Model.Faktura.PodatekWZlotych) PLN</strong>
        </p>
    }
</div>

@* Faktura końcowa obejmuje całą dostawę, ale część nabywca opłacił już
   zaliczką - i to musi być widać, żeby nikt nie zapłacił drugi raz
   (art. 106f ust. 3 ustawy). *@
@if (Model.Faktura.RozliczoneZaliczki.Count > 0)
{
    <div class="karta">
        <h2 style="margin-top:0">Rozliczone zaliczki</h2>

        <table class="pozycje">
            <thead>
                <tr>
                    <th>Numer</th>
                    <th>Wystawiona</th>
                    <th>Numer KSeF</th>
                    <th class="liczba">Kwota</th>
                </tr>
            </thead>
            <tbody>
                @foreach (RozliczonaZaliczka zaliczka in
                          Model.Faktura.RozliczoneZaliczki.OrderBy(z => z.DataWystawienia))
                {
                    <tr>
                        <td><strong>@zaliczka.Numer</strong></td>
                        <td>@zaliczka.DataWystawienia.ToString("yyyy-MM-dd")</td>
                        <td>@(zaliczka.NumerKsef ?? "—")</td>
                        <td class="liczba">@Kwoty.NaTekst(zaliczka.Brutto)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="podsumowanie-kwot">
            <div>
                <div class="etykieta">Zafakturowane zaliczkami</div>
                <div class="kwota">@Kwoty.NaTekst(Model.SumaZaliczek)</div>
            </div>
            <div class="razem">
                <div class="etykieta">Pozostaje z tej faktury</div>
                <div class="kwota">
                    @Kwoty.NaTekst(Model.Faktura.RazemBrutto - Model.SumaZaliczek)
                    @Model.Faktura.Waluta
                </div>
            </div>
        </div>
    </div>
}

<div class="paskiem">
    @if (Model.Faktura.Status != StatusKsef.Przyjeta)
    {
        <form method="post" asp-page-handler="Wyslij">
            <button type="submit">Wyślij do KSeF</button>
        </form>
    }

    @* Poświadczenie powstaje z opóźnieniem po zamknięciu sesji, więc próba
       przy wysyłce bywa za wczesna. Przycisk pojawia się tylko wtedy, gdy
       naprawdę jest co pobierać. *@
    @if (Model.Faktura.Status == StatusKsef.Przyjeta && !Model.Faktura.MaUpo)
    {
        <form method="post" asp-page-handler="Upo" asp-route-id="@Model.Faktura.Id">
            <button type="submit" class="przycisk-drugi">Pobierz UPO</button>
        </form>
    }

    @* Korektę można wystawić także do korekty - drugą poprawkę tej samej
       faktury robi się właśnie tak. *@
    <a class="przycisk przycisk-drugi" asp-page="Korekta"
       asp-route-id="@Model.Faktura.Id">Wystaw korektę</a>

    @* Rozliczonej już zaliczki nie da się rozliczyć drugi raz, więc odsyłanie
       do formularza końcowej byłoby ślepą uliczką. *@
    @if (Model.Faktura.Rodzaj == RodzajFaktury.Zaliczkowa && !Model.ZaliczkaRozliczona)
    {
        <a class="przycisk przycisk-drugi" asp-page="Koncowa"
           asp-route-id="@Model.Faktura.Id">Wystaw fakturę końcową</a>
    }

    @* Wyróżniony kolorem jest tylko jeden przycisk w rzędzie - ten, który
       coś wysyła. Pobranie pliku nie jest nieodwracalne, więc nie musi
       przyciągać wzroku tak samo mocno. *@
    <a class="przycisk przycisk-drugi" asp-page-handler="Pdf"
       asp-route-id="@Model.Faktura.Id">Pobierz PDF</a>
    <a class="przycisk przycisk-drugi" asp-page-handler="Xml"
       asp-route-id="@Model.Faktura.Id">Pobierz XML</a>
    @* Duplikat wydaje się, gdy odbiorca zgubił egzemplarz (art. 106l ustawy) -
       treść jest ta sama, zmienia się samo oznaczenie i data wydania. *@
    <a class="przycisk przycisk-drugi" asp-page-handler="Pdf"
       asp-route-id="@Model.Faktura.Id" asp-route-duplikat="true">Duplikat</a>
    <a class="przycisk przycisk-drugi" asp-page="Index">Wróć do listy</a>
</div>


<h2>Zapłata</h2>

@if (Model.WalidacjaWplaty.SaBledy)
{
    <div class="powiadomienie niepowodzenie">
        <ul class="bledy">
            @foreach (Problem problem in Model.WalidacjaWplaty.Problemy
                          .Where(p => p.Poziom == PoziomProblemu.Blad))
            {
                <li>@problem.Komunikat</li>
            }
        </ul>
    </div>
}

<div class="kafelki">
    <div class="kafelek">
        <span class="etykieta">Stan</span>
        <span class="kwota" style="font-size:1.1rem">@Model.Rozliczenie.Opis</span>
        @if (Model.Rozliczenie.PoTerminie)
        {
            <span class="drobne">po terminie o @Model.Rozliczenie.DniPoTerminie dni</span>
        }
    </div>
    <div class="kafelek">
        <span class="etykieta">Wpłacono</span>
        <span class="kwota">@Kwoty.NaTekst(Model.Rozliczenie.Zaplacono)</span>
    </div>
    <div class="kafelek wyroznik">
        <span class="etykieta">Pozostaje</span>
        <span class="kwota">@Kwoty.NaTekst(Model.Rozliczenie.Pozostalo)</span>
    </div>
</div>

@if (Model.Wplaty.Count > 0)
{
    <table>
        <thead>
            <tr>
                <th>Data wpłaty</th>
                <th class="liczba">Kwota</th>
                <th>Uwagi</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Platnosc wplata in Model.Wplaty)
            {
                <tr>
                    <td class="nowrap">@wplata.Data.ToString("yyyy-MM-dd")</td>
                    <td class="liczba">@Kwoty.NaTekst(wplata.Kwota)</td>
                    <td>@wplata.Uwagi</td>
                    <td>
                        <form method="post" asp-page-handler="UsunWplate"
                              asp-route-id="@Model.Faktura.Id" asp-route-wplataId="@wplata.Id"
                              onsubmit="return confirm('Usunąć tę wpłatę?')">
                            <button type="submit" class="usun-wiersz" title="Usuń wpłatę">&times;</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.Rozliczenie.Pozostalo > 0)
{
    <div class="karta">
        <form method="post" asp-page-handler="Wplata" asp-route-id="@Model.Faktura.Id">
            <div class="siatka">
                <div class="pole">
                    <label for="kwota">Kwota wpłaty</label>
                    <input type="number" id="kwota" name="KwotaWplaty" step="0.01" min="0.01"
                           value="@Model.KwotaWplaty.ToString("0.00", CultureInfo.InvariantCulture)"
                           required />
                </div>

                <div class="pole">
                    <label for="dataWplaty">Data wpłaty</label>
                    <input type="date" id="dataWplaty" name="DataWplaty"
                           value="@Model.DataWplaty.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="pole">
                    <label for="uwagiWplaty">Uwagi</label>
                    <input type="text" id="uwagiWplaty" name="UwagiWplaty"
                           value="@Model.UwagiWplaty" maxlength="500"
                           placeholder="np. przelew, wpłata częściowa" />
                </div>
            </div>

            <div class="paskiem">
                <button type="submit">Zapisz wpłatę</button>
            </div>
        </form>
    </div>
}

<h2>Wyślij kontrahentowi</h2>

@if (Model.WalidacjaWysylki.SaBledy)
{
    <div class="powiadomienie niepowodzenie">
        <ul class="bledy">
            @foreach (Problem problem in Model.WalidacjaWysylki.Problemy
                          .Where(p => p.Poziom == PoziomProblemu.Blad))
            {
                <li>@problem.Komunikat</li>
            }
        </ul>
    </div>
}

<div class="karta">
    @if (!Model.PocztaDziala)
    {
        <p class="wskazowka" style="margin:0">
            Poczta nie jest skonfigurowana w tej instalacji, więc program nie wyśle
            wiadomości. Pobierz PDF powyżej i wyślij go swoją pocztą — albo poproś
            o ustawienie serwera poczty we wdrożeniu.
        </p>
    }
    else
    {
        <form method="post" asp-page-handler="Poczta" asp-route-id="@Model.Faktura.Id">
            <div class="pole">
                <label for="adres">Adres odbiorcy</label>
                <input type="email" id="adres" name="Adres" value="@Model.Adres"
                       required maxlength="256" />
            </div>

            <div class="pole">
                <label for="wiadomosc">Wiadomość (opcjonalnie)</label>
                <input type="text" id="wiadomosc" name="Wiadomosc" value="@Model.Wiadomosc"
                       maxlength="500"
                       placeholder="W załączeniu przesyłamy fakturę." />
            </div>

            <div class="pole-wyboru">
                @* Odznaczone pole wyboru nie wysyła nic, więc pod spodem stoi
                   ukryte pole z wartością przeciwną. *@
                <input type="checkbox" id="xml" name="DolaczXml" value="true" />
                <input type="hidden" name="DolaczXml" value="false" />
                <label for="xml">Dołącz także plik XML</label>
            </div>

            <p class="wskazowka">
                W załączeniu idzie ta sama wizualizacja PDF, którą można pobrać
                powyżej — z kodem QR, jeśli faktura jest już w KSeF.
            </p>

            @* Oba przyciski należą do jednego formularza, więc korzystają
               z adresu wpisanego wyżej. Przy dwóch osobnych formularzach
               przypomnienie szłoby ze starą wartością pola - i kończyło się
               błędem tuż po tym, jak użytkownik poprawił adres. *@
            <div class="paskiem">
                <button type="submit">Wyślij e-mailem</button>

                @if (Model.Rozliczenie.Pozostalo > 0)
                {
                    <button type="submit" class="przycisk-drugi"
                            formaction="@Url.Page("Szczegoly", "Przypomnij", new { id = Model.Faktura.Id })">
                        Wyślij przypomnienie o zapłacie
                    </button>
                }
            </div>

            @if (Model.Rozliczenie.Pozostalo > 0)
            {
                <p class="wskazowka">
                    Przypomnienie niesie kwotę pozostałą do zapłaty i fakturę
                    w załączniku — bez pliku XML.
                </p>
            }
        </form>
    }
</div>

@if (Model.Wysylki.Count > 0)
{
    <table>
        <thead>
            <tr>
                <th>Wysłano</th>
                <th>Adres</th>
                <th>Załączniki</th>
            </tr>
        </thead>
        <tbody>
            @foreach (WyslanieFaktury wyslanie in Model.Wysylki)
            {
                <tr>
                    <td class="nowrap">@wyslanie.WyslanoUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@wyslanie.Adres</td>
                    <td>@(wyslanie.ZXmlem ? "PDF i XML" : "PDF")</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.Faktura.Status != StatusKsef.Przyjeta)
{
    <p style="color:var(--tekst-szary);font-size:0.88rem;margin-top:14px">
        Wysłanej faktury nie można usunąć ani poprawić — błędy koryguje się
        fakturą korygującą.
    </p>
}
