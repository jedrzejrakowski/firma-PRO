@using System.Security.Claims
@using FirmaPro.Dane.Encje
@using FirmaPro.Web.Uslugi
@inject UslugaKont UslugaKont
@{
    string? nazwaFirmy = User.FindFirstValue(Tozsamosc.NazwaFirmy);
    bool zalogowany = User.Identity?.IsAuthenticated == true;
    bool wlasciciel = User.IsInRole(nameof(RolaWFirmie.Wlasciciel));

    // Biuro rachunkowe pracuje jednym kontem w wielu firmach. Listę czytamy
    // z bazy, a nie z ciasteczka - dopisanie do nowej firmy ma być widoczne
    // od razu, bez ponownego logowania.
    IReadOnlyList<CzlonkostwoWFirmie> mojeFirmy =
        zalogowany && Tozsamosc.UzytkownikId(User) is Guid ktoZalogowany
            ? await UslugaKont.FirmyUzytkownikaAsync(ktoZalogowany)
            : [];
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Tytul"] — Firma PRO</title>
    <link rel="stylesheet" href="~/css/firmapro.css" asp-append-version="true" />
</head>
<body>
    <header class="pasek">
        <div class="pasek-tresc">
            <a class="znak" asp-page="/Index">Firma&nbsp;PRO</a>

            @if (zalogowany)
            {
                <nav class="nawigacja">
                    <a asp-page="/Faktury/Index">Faktury</a>
                    <a asp-page="/Zakupy/Index">Zakupy</a>
                    <a asp-page="/Naleznosci">Należności</a>
                    <a asp-page="/Kontrahenci/Index">Kontrahenci</a>
                    <a asp-page="/Rejestry/Vat">Rejestr VAT</a>
                    <a asp-page="/Rejestry/Jpk">JPK_V7</a>
                    @if (wlasciciel)
                    {
                        <a asp-page="/Ustawienia">Ustawienia</a>
                        <a asp-page="/Uzytkownicy/Index">Dostęp</a>
                    }
                </nav>
                <div class="konto">
                    @if (mojeFirmy.Count > 1)
                    {
                        <form method="post" asp-page="/PrzelaczFirme" class="wybor-firmy">
                            <select name="firmaId" onchange="this.form.submit()"
                                    title="Firma, w której kontekście pracujesz">
                                @foreach (CzlonkostwoWFirmie czlonkostwo in mojeFirmy)
                                {
                                    <option value="@czlonkostwo.FirmaId"
                                            selected="@(czlonkostwo.Firma?.Nazwa == nazwaFirmy)">
                                        @czlonkostwo.Firma?.Nazwa
                                    </option>
                                }
                            </select>
                            <noscript><button type="submit">Przejdź</button></noscript>
                        </form>
                    }
                    else
                    {
                        <span class="firma" title="Firma, w której kontekście pracujesz">
                            @nazwaFirmy
                        </span>
                    }
                    <a class="konto-odnosnik" asp-page="/Konto"
                       title="Moje konto i hasło">@User.Identity?.Name</a>
                    <form method="post" asp-page="/Wyloguj">
                        <button type="submit" class="odnosnik-przycisk">Wyloguj</button>
                    </form>
                </div>
            }
        </div>
    </header>

    <main class="tresc">
        @if (TempData["Komunikat"] is string komunikat)
        {
            <div class="powiadomienie powodzenie">@komunikat</div>
        }
        @if (TempData["Ostrzezenie"] is string ostrzezenie)
        {
            <div class="powiadomienie niepowodzenie">@ostrzezenie</div>
        }

        @RenderBody()
    </main>

    <footer class="stopka">
        Firma PRO · faktury zgodne z KSeF (wzór FA(3))
    </footer>

    @await RenderSectionAsync("Skrypty", required: false)
</body>
</html>
