@page
@model FirmaPro.Web.Pages.Kontrahenci.NowyModel
@{
    ViewData["Tytul"] = "Nowy kontrahent";
}

<h1>Nowy kontrahent</h1>
<p class="podtytul">Dane trafią na fakturę, więc warto je od razu sprawdzić.</p>

<div class="karta" style="max-width:640px">
    @if (Model.Bledy.Count > 0)
    {
        <div class="powiadomienie niepowodzenie">
            <ul class="bledy">
                @foreach (string blad in Model.Bledy)
                {
                    <li>@blad</li>
                }
            </ul>
        </div>
    }

    <form method="post">
        <div class="pole">
            <label for="nazwa">Nazwa</label>
            <input type="text" id="nazwa" name="Nazwa" value="@Model.Nazwa"
                   required autofocus maxlength="512" />
        </div>

        <div class="siatka">
            <div class="pole">
                <label for="nip">NIP</label>
                <input type="text" id="nip" name="Nip" value="@Model.Nip"
                       maxlength="13" placeholder="np. 5252248481" />
            </div>
            <div class="pole">
                <label for="kraj">Kod kraju</label>
                <input type="text" id="kraj" name="KodKraju" value="@Model.KodKraju"
                       maxlength="2" required />
            </div>
        </div>

        <p style="margin-top:-8px;color:var(--tekst-szary);font-size:0.86rem">
            Nabywca będący osobą prywatną nie ma NIP — zostaw pole puste.
        </p>

        <div class="pole">
            <label for="adres1">Ulica i numer</label>
            <input type="text" id="adres1" name="AdresLinia1" value="@Model.AdresLinia1"
                   maxlength="512" />
        </div>

        <div class="pole">
            <label for="adres2">Kod pocztowy i miejscowość</label>
            <input type="text" id="adres2" name="AdresLinia2" value="@Model.AdresLinia2"
                   maxlength="512" />
        </div>

        <div class="siatka">
            <div class="pole">
                <label for="email">E-mail</label>
                <input type="email" id="email" name="Email" value="@Model.Email" />
            </div>
            <div class="pole">
                <label for="telefon">Telefon</label>
                <input type="text" id="telefon" name="Telefon" value="@Model.Telefon" />
            </div>
        </div>

        <div class="paskiem">
            <button type="submit">Zapisz</button>
            <a class="przycisk przycisk-drugi" asp-page="Index">Anuluj</a>
        </div>
    </form>
</div>
