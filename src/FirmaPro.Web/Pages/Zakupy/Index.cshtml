@page
@using FirmaPro.Dane.Encje
@using FirmaPro.Domena
@model FirmaPro.Web.Pages.Zakupy.IndexModel
@{
    ViewData["Tytul"] = "Faktury zakupu";
}

<h1>Faktury zakupu</h1>
<p class="podtytul">Dokumenty otrzymane od dostawców, ujmowane w rejestrze VAT.</p>

<div class="paskiem" style="margin-bottom:18px">
    <a class="przycisk" asp-page="Nowa">Wprowadź fakturę</a>
    <a class="przycisk przycisk-drugi" asp-page="/Rejestry/Vat">Rejestr VAT</a>
</div>

@if (Model.Faktury.Count == 0)
{
    <p class="pusto">Nie wprowadzono jeszcze żadnej faktury zakupu.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Okres odliczenia</th>
                <th>Numer</th>
                <th>Sprzedawca</th>
                <th>Wystawiono</th>
                <th>Wpłynęła</th>
                <th class="liczba">Netto</th>
                <th class="liczba">VAT</th>
                <th class="liczba">Brutto</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (FakturaZakupu faktura in Model.Faktury)
            {
                <tr>
                    <td class="nowrap">@Model.OpisOkresu(faktura.DataUjecia)</td>
                    <td class="nowrap"><strong>@faktura.Numer</strong></td>
                    <td>
                        @faktura.SprzedawcaNazwa
                        @if (!faktura.Odliczany)
                        {
                            <span class="znacznik">bez odliczenia</span>
                        }
                        @if (faktura.Rodzaj == RodzajZakupu.SrodkiTrwale)
                        {
                            <span class="znacznik">środek trwały</span>
                        }
                    </td>
                    <td class="nowrap">@faktura.DataWystawienia.ToString("yyyy-MM-dd")</td>
                    <td class="nowrap">@faktura.DataWplywu.ToString("yyyy-MM-dd")</td>
                    <td class="liczba">@faktura.RazemNetto.ToString("N2")</td>
                    <td class="liczba">@faktura.RazemVat.ToString("N2")</td>
                    <td class="liczba"><strong>@faktura.RazemBrutto.ToString("N2")</strong></td>
                    <td>
                        <form method="post" asp-page-handler="Usun" asp-route-id="@faktura.Id"
                              onsubmit="return confirm('Usunąć fakturę @faktura.Numer z rejestru?')">
                            <button type="submit" class="usun-wiersz" title="Usuń">&times;</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
