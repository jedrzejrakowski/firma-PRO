@page
@using FirmaPro.Domena
@model FirmaPro.Web.Pages.UstawieniaModel
@{
    ViewData["Tytul"] = "Ustawienia firmy";
}

<h1>Ustawienia firmy</h1>
<p class="podtytul">Te dane trafiają na każdą wystawioną fakturę.</p>

<div class="karta" style="max-width:760px">
    @if (Model.Bledy.Count > 0)
    {
        <div class="powiadomienie niepowodzenie">
            <ul class="bledy">
                @foreach (string blad in Model.Bledy)
                {
                    <li>@blad</li>
                }
            </ul>
        </div>
    }

    <form method="post">
        <h2 class="naglowek-sekcji">Dane sprzedawcy</h2>

        <div class="pole">
            <label for="nazwa">Nazwa firmy</label>
            <input type="text" id="nazwa" name="Nazwa" value="@Model.Nazwa"
                   required maxlength="512" />
        </div>

        <div class="siatka">
            <div class="pole">
                <label for="nip">NIP</label>
                <input type="text" id="nip" name="Nip" value="@Model.Nip"
                       required maxlength="13" />
            </div>
            <div class="pole">
                <label for="kraj">Kod kraju</label>
                <input type="text" id="kraj" name="KodKraju" value="@Model.KodKraju"
                       required maxlength="2" />
            </div>
        </div>

        <div class="pole">
            <label for="adres1">Ulica i numer</label>
            <input type="text" id="adres1" name="AdresLinia1" value="@Model.AdresLinia1"
                   required maxlength="512" />
        </div>

        <div class="pole">
            <label for="adres2">Kod pocztowy i miejscowość</label>
            <input type="text" id="adres2" name="AdresLinia2" value="@Model.AdresLinia2"
                   maxlength="512" />
        </div>

        <div class="siatka">
            <div class="pole">
                <label for="email">E-mail</label>
                <input type="email" id="email" name="Email" value="@Model.Email" />
            </div>
            <div class="pole">
                <label for="telefon">Telefon</label>
                <input type="text" id="telefon" name="Telefon" value="@Model.Telefon" />
            </div>
        </div>

        <h2 class="naglowek-sekcji">Płatności i wygląd faktury</h2>

        <div class="siatka">
            <div class="pole">
                <label for="rachunek">Rachunek bankowy</label>
                <input type="text" id="rachunek" name="RachunekBankowy"
                       value="@Model.RachunekBankowy" maxlength="34" />
            </div>
            <div class="pole">
                <label for="bank">Nazwa banku</label>
                <input type="text" id="bank" name="NazwaBanku" value="@Model.NazwaBanku" />
            </div>
        </div>

        <div class="siatka">
            <div class="pole">
                <label for="miejsce">Miejsce wystawienia</label>
                <input type="text" id="miejsce" name="MiejsceWystawienia"
                       value="@Model.MiejsceWystawienia" />
            </div>
            <div class="pole">
                <label for="termin">Domyślny termin płatności (dni)</label>
                <input type="number" id="termin" name="DomyslnyTerminPlatnosciDni"
                       value="@Model.DomyslnyTerminPlatnosciDni" min="0" max="365" />
            </div>
        </div>

        <div class="pole">
            <label for="stopka">Stopka faktury</label>
            <input type="text" id="stopka" name="StopkaFaktury"
                   value="@Model.StopkaFaktury" maxlength="3500" />
        </div>

        <h2 class="naglowek-sekcji">Rozliczenie VAT</h2>

        <div class="siatka">
            <div class="pole">
                <label for="typOkresu">Okres rozliczeniowy</label>
                <select id="typOkresu" name="TypOkresuVat">
                    <option value="@TypOkresu.Miesieczny"
                            selected="@(Model.TypOkresuVat == TypOkresu.Miesieczny)">
                        Miesięczny
                    </option>
                    <option value="@TypOkresu.Kwartalny"
                            selected="@(Model.TypOkresuVat == TypOkresu.Kwartalny)">
                        Kwartalny (mały podatnik)
                    </option>
                </select>
            </div>

            <div class="pole">
                <label for="kodUrzedu">Kod urzędu skarbowego</label>
                <input type="text" id="kodUrzedu" name="KodUrzeduSkarbowego"
                       value="@Model.KodUrzeduSkarbowego" maxlength="4"
                       placeholder="np. 1471" />
            </div>
        </div>

        <p class="wskazowka">
            Kod urzędu trafia do pliku JPK_V7. Wykaz publikuje Ministerstwo
            Finansów — w tym samym mieście urząd dla osób fizycznych ma inny kod
            niż dla spółek, więc nie da się go wywnioskować z adresu.
        </p>

        <h2 class="naglowek-sekcji">Dostęp do KSeF</h2>

        <div class="pole">
            <label for="srodowisko">Środowisko</label>
            <select id="srodowisko" name="Srodowisko">
                @foreach (SrodowiskoKsef srodowisko in Enum.GetValues<SrodowiskoKsef>())
                {
                    <option value="@srodowisko" selected="@(srodowisko == Model.Srodowisko)">
                        @OpisSrodowiska(srodowisko)
                    </option>
                }
            </select>
        </div>

        <div class="pole">
            <label for="metoda">Sposób uwierzytelnienia</label>
            <select id="metoda" name="MetodaUwierzytelnienia">
                <option value="@MetodaUwierzytelnieniaKsef.Token"
                        selected="@(Model.MetodaUwierzytelnienia == MetodaUwierzytelnieniaKsef.Token)">
                    Token — działa do końca 2026 roku
                </option>
                <option value="@MetodaUwierzytelnieniaKsef.Certyfikat"
                        selected="@(Model.MetodaUwierzytelnienia == MetodaUwierzytelnieniaKsef.Certyfikat)">
                    Certyfikat KSeF — obowiązkowy od stycznia 2027
                </option>
            </select>
            <p class="wskazowka">
                Od 1 stycznia 2027 tokeny przestają działać i pozostaje wyłącznie
                certyfikat. Obie drogi działają dziś równolegle, więc przejście
                jest zmianą tego ustawienia — nie trzeba czekać na termin.
            </p>
        </div>

        @if (Model.TokenZeSrodowiska)
        {
            <div class="powiadomienie">
                Token pobierany jest ze zmiennej środowiskowej <code>KSEF_TOKEN</code>
                i ma pierwszeństwo przed zapisanym poniżej.
            </div>
        }

        <div class="pole">
            <label for="token">
                Token KSeF
                @if (Model.TokenZapisany)
                {
                    <span class="znacznik znacznik-ok">zapisany</span>
                }
                else
                {
                    <span class="znacznik">brak</span>
                }
            </label>
            <input type="password" id="token" name="TokenKsef" autocomplete="new-password"
                   placeholder="@(Model.TokenZapisany ? "zostaw puste, aby nie zmieniać" : "wklej token wygenerowany w KSeF")" />
            <p class="wskazowka">
                Token wygenerujesz na stronie KSeF wybranego środowiska. Zapisujemy go
                w postaci zaszyfrowanej i nigdy nie pokazujemy ponownie — po zapisaniu
                zobaczysz wyłącznie informację, że istnieje.
            </p>
        </div>

        @if (Model.TokenZapisany)
        {
            <div class="pole-wyboru">
                <input type="checkbox" id="usunToken" name="UsunToken" value="true" />
                <label for="usunToken">Usuń zapisany token</label>
            </div>
        }

        <p class="wskazowka">
            Po zapisaniu ustawień warto od razu
            <a asp-page="Ksef">sprawdzić połączenie z KSeF</a> — sprawdzenie
            przechodzi całą drogę wysyłki, ale niczego nie wystawia.
        </p>

        <div class="paskiem">
            <button type="submit">Zapisz ustawienia</button>
            <a class="przycisk przycisk-drugi" asp-page="/Faktury/Index">Wróć</a>
        </div>
    </form>
</div>

<div class="karta" style="max-width:760px">
    <h2 class="naglowek-sekcji" style="margin-top:0">Certyfikat KSeF</h2>

    @if (Model.Certyfikat is { } certyfikat)
    {
        @if (certyfikat.Wygasl)
        {
            <div class="powiadomienie niepowodzenie">
                <strong>Certyfikat stracił ważność.</strong>
                <span>Program nie zaloguje się nim do KSeF. Wgraj nowy.</span>
            </div>
        }
        else if (certyfikat.WkrotceWygasnie)
        {
            <div class="powiadomienie">
                <strong>Certyfikat wygasa za @certyfikat.DniDoKonca dni.</strong>
                <span>
                    Wystąp o nowy zawczasu — po tej dacie wysyłka faktur
                    zatrzyma się bez ostrzeżenia.
                </span>
            </div>
        }

        <div class="siatka">
            <div class="pole">
                <label>Wystawiony dla</label>
                <p>@certyfikat.Podmiot</p>
            </div>
            <div class="pole">
                <label>Ważny do</label>
                <p>@certyfikat.WaznyDo.ToString("yyyy-MM-dd")</p>
            </div>
        </div>

        <div class="pole">
            <label>Odcisk (SHA-256)</label>
            <p class="numer-ksef">@certyfikat.Odcisk</p>
        </div>

        <form method="post" asp-page-handler="UsunCertyfikat">
            <button type="submit" class="przycisk przycisk-drugi">Usuń certyfikat</button>
        </form>

        <hr />
        <p class="wskazowka">Wgranie nowego pliku zastąpi certyfikat powyżej.</p>
    }
    else
    {
        <p class="wskazowka">
            Nie zapisano certyfikatu. Wgraj plik PFX albo P12 — musi zawierać
            klucz prywatny, bo to nim program podpisuje żądanie logowania.
        </p>
    }

    <form method="post" asp-page-handler="Certyfikat" enctype="multipart/form-data">
        <div class="siatka">
            <div class="pole">
                <label for="plikCertyfikatu">Plik certyfikatu</label>
                <input type="file" id="plikCertyfikatu" name="PlikCertyfikatu"
                       accept=".pfx,.p12" />
            </div>
            <div class="pole">
                <label for="hasloCertyfikatu">Hasło pliku</label>
                <input type="password" id="hasloCertyfikatu" name="HasloCertyfikatu"
                       autocomplete="new-password" placeholder="zostaw puste, gdy plik go nie ma" />
            </div>
        </div>

        <p class="wskazowka">
            Certyfikat zapisujemy zaszyfrowany, tak samo jak token. Hasło pliku
            służy wyłącznie do jego odczytania i nie jest nigdzie zapisywane.
        </p>

        <button type="submit">Wgraj certyfikat</button>
    </form>

    @if (Model.Srodowisko != SrodowiskoKsef.Produkcja)
    {
        <hr />

        <p class="wskazowka">
            Środowisko testowe przyjmuje certyfikaty samopodpisane, więc całą
            drogę można sprawdzić bez występowania o prawdziwy certyfikat.
            Na produkcji taki certyfikat zostanie odrzucony.
        </p>

        <form method="post" asp-page-handler="TestowyCertyfikat">
            <button type="submit" class="przycisk przycisk-drugi">
                Wystaw certyfikat testowy
            </button>
        </form>
    }
</div>

@functions {
    private static string OpisSrodowiska(SrodowiskoKsef srodowisko) => srodowisko switch
    {
        SrodowiskoKsef.Test => "Testowe — faktury nie mają mocy prawnej",
        SrodowiskoKsef.Demo => "Demo — dane zbliżone do produkcji, bez skutków prawnych",
        SrodowiskoKsef.Produkcja => "Produkcyjne — faktury trafiają do obiegu prawnego",
        _ => srodowisko.ToString()
    };
}
